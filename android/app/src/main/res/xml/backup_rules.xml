<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 6-11 (pre-targetSdk 31).
    Defines what data is included in Auto Backup.
    Include WebView/localStorage data, exclude caches.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <include domain="file" path="." />
    <exclude domain="cache" path="." />
    <exclude domain="no_backup" path="." />
</full-backup-content>
