<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (targetSdk 31+).
    Defines what data is included in cloud backups and device-to-device transfers.
    This app stores all data in WebView localStorage (DOM storage),
    so we include the WebView data directories.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="no_backup" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
